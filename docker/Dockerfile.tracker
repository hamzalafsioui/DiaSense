FROM python:3.12-slim

ARG MLFLOW_VERSION=3.17.0

ENV PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    PIP_DEFAULT_TIMEOUT=120 \
    PIP_RETRIES=5

WORKDIR /app

# Copy dependency files first (layer-cache friendly)
COPY requirements.txt pyproject.toml ./

RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code after dependencies are installed
COPY src ./src

# Install diasense package in editable mode (no extra deps)
RUN pip install --no-cache-dir --no-deps -e .

# Execute tracking script as a module
CMD ["python", "-m", "diasense.mlflow_tracking"]
